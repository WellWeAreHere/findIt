# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- MySQL (local) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=findit
# Separate database used by `npm run db:test` (dropped and rebuilt on every test run)
MYSQL_TEST_DATABASE=findit_test

# --- MongoDB (Atlas free M0 cluster, or a local mongod) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=findit
MONGODB_TEST_DB=findit_test

# --- App (used from Part 2) ---
JWT_SECRET=generate_a_long_random_string_here
UPLOAD_DIR=./uploads
