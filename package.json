{
  "name": "findit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FindIt - Intelligent Campus Lost and Found Management System",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:build-seed": "node database/seed/build-sql.js",
    "db:setup": "node --env-file=.env.local database/setup.js",
    "db:test": "node --env-file=.env.local --test --test-concurrency=1 \"database/tests/*.test.js\"",
    "test:api": "node --env-file=.env.local --test --test-concurrency=1 \"tests/*.test.js\"",
    "test": "npm run db:test && npm run build && npm run test:api"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.1.0",
    "mongodb": "^7.8.0",
    "mysql2": "^3.24.6",
    "next": "^15.5.28",
    "postcss": "^8.5.30",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  }
}
